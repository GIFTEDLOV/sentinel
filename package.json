{
  "name": "sentinel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --configLoader native",
    "build": "tsc --noEmit && vite build --configLoader native",
    "typecheck": "tsc --noEmit",
    "lint": "eslint frontend vite.config.ts vitest.config.ts --max-warnings=0",
    "test": "vitest run --pool threads --configLoader native",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@genlayer/transaction-kit": "0.1.0-rc.2",
    "@genlayer/transaction-kit-react": "0.1.0-rc.2",
    "genlayer-js": "2.0.0-rc.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
